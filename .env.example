# DeepSeek chat models
DEEPSEEK_API_KEY=

# Embedded durable storage (no Docker or database service required)
LUXAR_STORAGE_DIRECTORY=.luxar-data

# Independent OpenAI-compatible embedding endpoint for LanceDB RAG
LUXAR_EMBEDDING_API_KEY=
LUXAR_EMBEDDING_BASE_URL=https://api.openai.com/v1
LUXAR_EMBEDDING_MODEL=text-embedding-3-small
LUXAR_EMBEDDING_DIMENSIONS=1536

LUXAR_PROJECTS_ROOT=./projects
LUXAR_WEB_PORT=8000
