# Conversation LLM (deepseek, openai, or local; dashboard settings override these)
LUXAR_LLM_PROVIDER=deepseek
LUXAR_LLM_API_KEY=
LUXAR_LLM_BASE_URL=https://api.deepseek.com
LUXAR_LLM_MODEL=deepseek-v4-flash
LUXAR_LLM_CONTEXT_WINDOW_TOKENS=1048576
# Keep interactive Agent commentary responsive; enable only when deeper reasoning is needed.
LUXAR_LLM_THINKING_ENABLED=false
LUXAR_LLM_THINKING_EFFORT=high

# Agent runtime: supervisor is the qualified default; set legacy for one-release rollback.
LUXAR_AGENT_RUNTIME=supervisor

# Conversation-first continuous Agent V2 is enabled by default.
# Set this to false only for an explicit emergency rollback.
LUXAR_CONTINUOUS_AGENT_V2=true

# Backward-compatible DeepSeek key
DEEPSEEK_API_KEY=

# Embedded durable storage (no Docker or database service required)
LUXAR_STORAGE_DIRECTORY=.luxar-data

# Project RAG embedding: local_hash (offline) or api (independent endpoint)
LUXAR_EMBEDDING_MODE=local_hash
LUXAR_EMBEDDING_PROVIDER=local
LUXAR_EMBEDDING_API_KEY=
LUXAR_EMBEDDING_BASE_URL=http://127.0.0.1:8082/v1
LUXAR_EMBEDDING_MODEL=
LUXAR_EMBEDDING_DIMENSIONS=384

# PDF image routing: inherit, separate, or python
LUXAR_DOCUMENT_VISION_MODE=python
# Used only in separate mode; any OpenAI-compatible local endpoint is supported.
LUXAR_DOCUMENT_VISION_API_KEY=
LUXAR_DOCUMENT_VISION_BASE_URL=https://api.openai.com/v1
LUXAR_DOCUMENT_VISION_MODEL=

LUXAR_PROJECTS_ROOT=./projects
LUXAR_WEB_PORT=8000
