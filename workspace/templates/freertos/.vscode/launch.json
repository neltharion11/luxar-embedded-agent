{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "LUXAR: ST-Link Debug",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "stlink",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/{PROJECT_NAME}.elf",
            "device": "{STM32_MCU}",
            "runToEntryPoint": "main",
            "preLaunchTask": "LUXAR: build",
            "gdbPath": "${workspaceFolder}/../../toolchains/gcc-arm/bin/arm-none-eabi-gdb.exe",
            "showDevDebugOutput": "none"
        }
    ]
}
